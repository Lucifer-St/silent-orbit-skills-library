{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silent-orbit.dev/schemas/customization-onboarding.v3.schema.json",
  "title": "CustomizationOnboardingV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "projectId", "configuredAt", "scope", "preview", "permissions"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "kind": { "const": "CustomizationOnboardingV3" },
    "projectId": { "$ref": "#/$defs/id" },
    "configuredAt": { "type": "string", "format": "date-time" },
    "scope": { "const": "project-only" },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "const": "bundled-static" } }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["globalInstall", "systemConfiguration", "outsideProjectWrites"],
      "properties": {
        "globalInstall": { "const": false },
        "systemConfiguration": { "const": false },
        "outsideProjectWrites": { "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 72, "pattern": "^[a-z0-9][a-z0-9.-]*$" }
  }
}
