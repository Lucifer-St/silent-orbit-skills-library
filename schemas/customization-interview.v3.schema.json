{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silent-orbit.dev/schemas/customization-interview.v3.schema.json",
  "title": "CustomizationInterviewV3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "locale", "profileId", "createdAt", "updatedAt", "cursor", "answers"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "kind": { "const": "CustomizationInterviewV3" },
    "locale": { "const": "zh-CN" },
    "profileId": { "$ref": "#/$defs/id" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "cursor": { "type": "integer", "minimum": 0, "maximum": 6 },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "familiar-places": { "$ref": "#/$defs/familiarPlacesAnswer" },
        "avoid": { "$ref": "#/$defs/avoidAnswer" },
        "feeling": { "$ref": "#/$defs/feelingAnswer" },
        "find-things": { "$ref": "#/$defs/findThingsAnswer" },
        "reading-surface": { "$ref": "#/$defs/readingSurfaceAnswer" },
        "comfort": { "$ref": "#/$defs/comfortAnswer" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 72, "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "status", "summary", "values", "confidence", "inference"],
      "properties": {
        "questionId": { "enum": ["familiar-places", "avoid", "feeling", "find-things", "reading-surface", "comfort"] },
        "status": { "enum": ["answered", "uncertain", "skipped"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "values": { "type": "object" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "inference": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "oneOf": [
        {
          "properties": {
            "questionId": { "const": "familiar-places" },
            "values": { "type": "object", "additionalProperties": false, "required": ["references"], "properties": { "references": { "$ref": "#/$defs/stringList" } } }
          }
        },
        {
          "properties": {
            "questionId": { "const": "avoid" },
            "values": { "type": "object", "additionalProperties": false, "required": ["antiReferences"], "properties": { "antiReferences": { "$ref": "#/$defs/stringList" } } }
          }
        },
        {
          "properties": {
            "questionId": { "const": "feeling" },
            "values": { "type": "object", "additionalProperties": false, "required": ["qualities"], "properties": { "qualities": { "$ref": "#/$defs/stringList" } } }
          }
        },
        {
          "properties": {
            "questionId": { "const": "find-things" },
            "values": {
              "type": "object", "additionalProperties": false, "required": ["density", "navigation"],
              "properties": { "density": { "enum": ["compact", "balanced", "airy"] }, "navigation": { "enum": ["map-first", "library-first", "balanced"] } }
            }
          }
        },
        {
          "properties": {
            "questionId": { "const": "reading-surface" },
            "values": {
              "type": "object", "additionalProperties": false, "required": ["typography", "colorIntent", "highContrast"],
              "properties": { "typography": { "enum": ["editorial", "technical", "humanist"] }, "colorIntent": { "$ref": "#/$defs/stringList" }, "highContrast": { "type": "boolean" } }
            }
          }
        },
        {
          "properties": {
            "questionId": { "const": "comfort" },
            "values": {
              "type": "object", "additionalProperties": false, "required": ["motion", "reducedMotion", "highContrast", "mobilePriority"],
              "properties": {
                "motion": { "enum": ["still", "measured", "expressive"] },
                "reducedMotion": { "type": "boolean" },
                "highContrast": { "type": "boolean" },
                "mobilePriority": { "enum": ["essential", "equal", "desktop-led"] }
              }
            }
          }
        }
      ]
    },
    "familiarPlacesAnswer": { "allOf": [{ "$ref": "#/$defs/answer" }, { "properties": { "questionId": { "const": "familiar-places" } } }] },
    "avoidAnswer": { "allOf": [{ "$ref": "#/$defs/answer" }, { "properties": { "questionId": { "const": "avoid" } } }] },
    "feelingAnswer": { "allOf": [{ "$ref": "#/$defs/answer" }, { "properties": { "questionId": { "const": "feeling" } } }] },
    "findThingsAnswer": { "allOf": [{ "$ref": "#/$defs/answer" }, { "properties": { "questionId": { "const": "find-things" } } }] },
    "readingSurfaceAnswer": { "allOf": [{ "$ref": "#/$defs/answer" }, { "properties": { "questionId": { "const": "reading-surface" } } }] },
    "comfortAnswer": { "allOf": [{ "$ref": "#/$defs/answer" }, { "properties": { "questionId": { "const": "comfort" } } }] },
    "stringList": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 240 } }
  }
}
